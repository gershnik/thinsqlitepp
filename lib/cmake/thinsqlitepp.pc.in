prefix=${pcfiledir}/@FROM_PCFILEDIR_TO_PREFIX@
exec_prefix=${prefix}
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

module=${prefix}/@CMAKE_INSTALL_DATAROOTDIR@/thinsqlitepp/thinsqlitepp.cppm

Name: thinsqlitepp
Description: A thin, safe and convenient C++ wrapper for SQLite API.
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
 
